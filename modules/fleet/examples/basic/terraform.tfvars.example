# Example values for the RunsOn Fleet stack.

stack_name = "runs-on-fleet-example"

aws_region = "us-east-1"

github_app_id = 123456

github_app_private_key = <<-EOT
-----BEGIN PRIVATE KEY-----
example
-----END PRIVATE KEY-----
EOT

github_base_url = "https://github.com"

environment = "production"
app_size    = "medium"

vpc_id = "vpc-0123456789abcdef0"

public_subnet_ids = [
  "subnet-0123456789abcdef0",
]

private_subnet_ids = [
  "subnet-0fedcba9876543210",
]

runtime_image = "public.ecr.aws/c5h5o9k1/runs-on/runs-on:test"

images = {
  ubuntu24-full-x64 = {
    ami            = "ami-0123456789abcdef0"
    platform       = "linux"
    arch           = "x64"
    main_disk_size = 60
  }
}

runners = {
  small-x64 = {
    cpu    = 2
    ram    = 4
    family = ["c7"]
    image  = "ubuntu24-full-x64"
  }
}

pools = {
  my-pool = {
    timezone     = "UTC"
    runner_group = "xxxx"
    runner       = "small-x64"
    schedule = [
      {
        name    = "default"
        hot     = 1
        stopped = 2
      }
    ]
  }
}
