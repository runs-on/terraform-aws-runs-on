#!/bin/bash -ex
date -u
mkdir -p /etc/runs-on /runs-on
cat <<EOF > /etc/runs-on/bootstrap.env
RUNS_ON_RUNNER_MAX_RUNTIME="${RunnerMaxRuntime}"
RUNS_ON_LOG_GROUP_NAME="${EC2InstanceLogGroup}"
RUNS_ON_DEBUG="${AppDebug}"
AWS_REGION="${Region}"
RUNS_ON_S3_BUCKET_CACHE="${S3BucketCache}"
RUNS_ON_BOOTSTRAP_TAG="${BootstrapTag}"
RUNS_ON_APP_TAG="${AppTag}"
RUNS_ON_AGENT_S3_BUCKET="${AgentS3Bucket}"
${EfsEnvLine}
${EphemeralRegistryEnvLine}
EOF

cat <<'EOF' > /usr/local/bin/runs-on-bootstrap.sh
#!/bin/bash
set -euo pipefail
exec > >(tee -a /runs-on/output.log /var/log/cloud-init-output.log) 2>&1

set -a
. /etc/runs-on/bootstrap.env
set +a

STATUS_FILE="/runs-on/bootstrap-status.env"
BOOTSTRAP_BIN="/usr/local/bin/runs-on-bootstrap-$RUNS_ON_BOOTSTRAP_TAG"
AGENT_BINARY_URL="$RUNS_ON_AGENT_S3_BUCKET/agent-linux-$(uname -m)"

cat <<'STATUS' > "$STATUS_FILE"
RUNS_ON_BOOTSTRAP_STATUS=running
STATUS

if [ ! -f "$BOOTSTRAP_BIN" ]; then
  time curl -L --connect-timeout 3 --max-time 15 --retry 5 -s \
    "https://github.com/runs-on/bootstrap/releases/download/$RUNS_ON_BOOTSTRAP_TAG/bootstrap-$RUNS_ON_BOOTSTRAP_TAG-linux-$(uname -m)" \
    -o "$BOOTSTRAP_BIN"
fi

chmod a+x "$BOOTSTRAP_BIN"
set +e
"$BOOTSTRAP_BIN" --debug="$RUNS_ON_DEBUG" --exec --post-exec shutdown "$AGENT_BINARY_URL"
exit_code=$?
set -e

cat <<STATUS > "$STATUS_FILE.tmp"
RUNS_ON_BOOTSTRAP_STATUS=completed
RUNS_ON_BOOTSTRAP_EXIT_CODE=$exit_code
STATUS
mv "$STATUS_FILE.tmp" "$STATUS_FILE"

exit "$exit_code"
EOF
chmod a+x /usr/local/bin/runs-on-bootstrap.sh

cat <<'EOF' > /usr/local/bin/runs-on-bootstrap-shutdown.sh
#!/bin/bash
set -euo pipefail

ENV_FILE="/etc/runs-on/bootstrap.env"
STATUS_FILE="/runs-on/bootstrap-status.env"
AGENT_BINARY="/runs-on/agent"

set -a
if [ -f "$ENV_FILE" ]; then
  . "$ENV_FILE"
fi
set +a

if [ "$(systemctl is-system-running 2>/dev/null || true)" = "stopping" ]; then
  echo "System is already stopping, skipping bootstrap shutdown helper."
  exit 0
fi

if [ -x "$AGENT_BINARY" ]; then
  if "$AGENT_BINARY" --shutdown-helper --env-file "$ENV_FILE" --status-file "$STATUS_FILE" --log-file /runs-on/output.log; then
    exit 0
  fi
  echo "Agent shutdown helper failed, falling back to shell shutdown."
else
  echo "Agent shutdown helper is unavailable, falling back to shell shutdown."
fi

if [ "${RUNS_ON_DEBUG:-false}" != "true" ]; then
  sleep 60
  shutdown -h now
fi
EOF
chmod a+x /usr/local/bin/runs-on-bootstrap-shutdown.sh

cat <<'EOF' > /etc/systemd/system/runs-on-bootstrap.service
[Unit]
Description=RunsOn Bootstrap Service
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target

[Service]
Type=exec
ExecStart=/usr/local/bin/runs-on-bootstrap.sh
ExecStopPost=/usr/local/bin/runs-on-bootstrap-shutdown.sh
StandardOutput=journal+console
StandardError=journal+console
Restart=no

[Install]
WantedBy=multi-user.target
EOF

if ! systemctl --no-block enable --now runs-on-bootstrap.service; then
  echo "Failed to enable/start runs-on-bootstrap.service via systemd, shutting down."
  /usr/local/bin/runs-on-bootstrap-shutdown.sh || true
  exit 1
fi
